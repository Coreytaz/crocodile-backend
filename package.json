{
  "name": "crocodile-backend",
  "version": "1.0.0",
  "description": "",
  "main": "build/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --env-file-if-exists=.env build/server.js",
    "dev": "nodemon --watch src --watch server.ts --watch tsconfig.json --ext ts,json --exec \"npm run build && npm start\"",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . --deny-warnings",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coreytaz/crocodile-backend.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Coreytaz/crocodile-backend/issues"
  },
  "homepage": "https://github.com/Coreytaz/crocodile-backend#readme",
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.3.0",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "nodemon": "3.1.14",
    "oxlint": "1.89.0",
    "socket.io-client": "4.8.4",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
